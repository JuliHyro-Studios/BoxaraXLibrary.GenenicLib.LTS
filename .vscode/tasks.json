{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pack NuGet Package",
            "type": "shell",
            "command": ".\\pack.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build ConsoleApp Tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/LibraryTestestProjects/ConsoleApp/ConsoleApp.csproj",
                "--configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
